{
  "name": "meraki-api-emulator",
  "version": "0.1.0",
  "description": "A local stand-in for the Cisco Meraki Dashboard API v1 with simulated networks, devices and traffic",
  "type": "module",
  "bin": {
    "meraki-api-emulator": "bin/meraki-api-emulator.js"
  },
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/meraki-api-emulator.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "meraki",
    "dashboard-api",
    "mock",
    "emulator",
    "simulator"
  ],
  "license": "MIT"
}
